@@ -0,0 +1,38 @@
+# float text reads and prints the same on the JS lane as on the C lane:
+# F32.read rounds the decimal once, as strtof does (the JS lane went
+# through a double, so a decimal whose double is an f32 midpoint rounded
+# twice: 16777217.00000000001 read as 16777216, the largest decimal under
+# the overflow threshold read as inf (#1055), the first decimal past 2^-150
+# read as 0); its leading space is ASCII only (\s took NBSP, U+00A0, which
+# strtof refuses); and F32.show rounds a decimal tie to even, as printf
+# does (toExponential rounds it up: 23577.5625 printed as 23577.563). An
+# IO main runs through the JS path under `bend file.bend`, so the check
+# lane's run pins the same text
+import Base
+
+def bits(m: Maybe<&2, F32>) -> String:
+  match m:
+    case None{}:
+      "None"
+    case Some{v}:
+      U32.show(F32.bits(v))
+
+def main() -> IO(Unit):
+  do IO<Unit>:
+    Unit <- IO.print(bits(F32.read("16777217.00000000001")))
+    Unit <- IO.print(bits(F32.read("-1.0000000596046447753906250001")))
+    Unit <- IO.print(bits(F32.read("340282356779733661637539395458142568447")))
+    Unit <- IO.print(bits(F32.read("7.0064923216240854e-46")))
+    Unit <- IO.print(bits(F32.read("\u{a0}1")))
+    Unit <- IO.print(bits(F32.read(" \t\u{b}\u{c}\r\n1")))
+    Unit <- IO.print(F32.show(23577.5625))
+    IO.print(F32.show(F32.neg(2983783.25)))
+
