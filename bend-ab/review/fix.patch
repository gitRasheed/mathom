+# F32.read and F32.show give the C lane's answer on JS: the read rounds a
+# decimal once (via a double, 16777217.00000000001 read as 16777216 and the
+# largest decimal under the overflow threshold as inf, #1055), its leading
+# space is ASCII only (NBSP read as 1), and show rounds a decimal tie to even
+# (23577.5625 printed as 23577.563)
+import Base
+
+def bits(m: Maybe<&2, F32>) -> String:
+  match m:
+    case None{}:
+      "None"
+    case Some{v}:
+      U32.show(F32.bits(v))
+
+def main.out() -> String:
+  bits(F32.read("16777217.00000000001"))
+    ++ (" " ++ bits(F32.read("340282356779733661637539395458142568447")))
+    ++ (" " ++ bits(F32.read("\u{a0}1")))
+    ++ (" " ++ bits(F32.read(" \t\u{b}\u{c}\r\n1")))
+    ++ (" " ++ F32.show(23577.5625))
+
+def main() -> IO(Unit):
+  IO.print(main.out())
